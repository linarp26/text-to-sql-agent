# Copy to .env and fill in your key. Never commit .env.

# --- LLM provider: "gemini" (free tier available) or "anthropic" ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=          # only needed when LLM_PROVIDER=anthropic

# Leave empty for the provider default (gemini-3.5-flash / claude-opus-5-5).
# On Gemini's free tier, gemini-3.1-flash-lite has more generous rate limits.
LLM_MODEL=
LLM_EFFORT=low
LLM_RATE_LIMIT_RETRIES=4

# The agent only ever connects as the read-only role.
DATABASE_URL=postgresql://analyst_ro:analyst_ro_dev_pw@localhost:5433/shop
# Used only by the eval harness to execute gold SQL.
ADMIN_DATABASE_URL=postgresql://shop_admin:shop_admin_dev_pw@localhost:5433/shop

MAX_RETRIES=3
ROW_LIMIT=1000
